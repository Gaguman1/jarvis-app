{
  "name": "jarvis-app",
  "private": true,
  "version": "1.10.3",
  "main": "dist-electron/main.js",
  "description": "J.A.R.V.I.S. - Asistente de Inteligencia Artificial",
  "author": "Antigravity",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.antigravity.jarvis",
    "productName": "J.A.R.V.I.S.",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "wake_word.py",
        "to": "wake_word.py"
      },
      {
        "from": "launch_app.ps1",
        "to": "launch_app.ps1"
      },
      {
        "from": "vosk-model-small-es-0.42",
        "to": "vosk-model-small-es-0.42",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".env",
        "to": ".env"
      },
      {
        "from": "system_control.ps1",
        "to": "system_control.ps1"
      },
      {
        "from": "get_weather.ps1",
        "to": "get_weather.ps1"
      },
      {
        "from": "dist_calendar/index.js",
        "to": "get_calendar.js"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "J.A.R.V.I.S."
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Gaguman1",
        "repo": "jarvis-app",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@google/genai": "^2.6.0",
    "@ricky0123/vad-react": "^0.0.36",
    "@ricky0123/vad-web": "^0.0.30",
    "electron-updater": "^6.8.9",
    "face-api.js": "^0.22.2",
    "firebase": "^12.13.0",
    "node-ical": "^0.26.1",
    "puppeteer": "^25.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/ncc": "^0.44.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7",
    "wait-on": "^9.0.10"
  }
}
